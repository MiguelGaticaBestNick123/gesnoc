{
  "name": "gesnoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "local": "next build && node scripts/servir.ts",
    "servir": "node scripts/servir.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integracion": "vitest run --project integracion",
    "test:e2e": "playwright test",
    "db:migrar": "dbmate -e DATABASE_URL_MIGRADOR --migrations-table migraciones.schema_migrations --no-dump-schema --wait migrate",
    "db:estado": "dbmate -e DATABASE_URL_MIGRADOR --migrations-table migraciones.schema_migrations status",
    "db:nueva": "dbmate new",
    "db:semilla": "node scripts/sembrar.ts",
    "db:reiniciar": "node scripts/reiniciar-demo.ts",
    "host:preparar": "node scripts/preparar-host.ts",
    "host:migrar": "node scripts/migrar-host.ts",
    "db:esquema": "drizzle-kit pull && node scripts/ajustar-esquema.mjs && prettier --write src/shared/db/esquema"
  },
  "dependencies": {
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@node-rs/argon2": "^2.2.2",
    "@tabler/icons-react": "^3.50.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dbmate": "^2.36.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "vitest": "^5.0.5"
  }
}
