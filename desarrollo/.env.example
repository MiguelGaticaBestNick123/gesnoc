# Copiar a .env y completar. .env nunca se sube al repositorio.

# Claves de los roles de base de datos (las usa Docker Compose al crear la base).
CLAVE_POSTGRES=cambiar
CLAVE_MIGRADOR=cambiar
CLAVE_APP=cambiar

# Conexión de la aplicación: rol gesnoc_app (solo datos).
DATABASE_URL=postgres://gesnoc_app:cambiar@localhost:5432/gesnoc

# Conexión de las migraciones (dbmate): rol gesnoc_migrador (dueño del esquema).
DATABASE_URL_MIGRADOR=postgres://gesnoc_migrador:cambiar@localhost:5432/gesnoc?sslmode=disable
